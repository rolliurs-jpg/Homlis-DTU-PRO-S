# Réseaux dédiés à l'installation solaire. Ne mettez jamais les mots de passe
# Wi-Fi dans ce fichier : ils restent chiffrés dans les profils NetworkManager.
ALFA_DEVICE=wlan2
ALFA_PROFILE=solaire-cabanon-alfa
# Renseignez vos propres adresses ou noms locaux, puis retirez le #.
# ALFA_ROUTER_HOST=192.168.x.x
# ALFA_PROXY_HOST=192.168.x.x
DTU_DEVICE=wlan1
DTU_PROFILE=dtu-direct-4p
# DTU_HOST=adresse-ou-nom-du-DTU
DTU_USB_RESET_COOLDOWN=1800
