[Unit]
Description=Boite noire Hoymiles (tableau solaire)
Wants=network-online.target
After=network-online.target
# Ne jamais abandonner les tentatives de redemarrage apres une coupure longue.
StartLimitIntervalSec=0

[Service]
Type=simple
# Replace these two values with the Linux account and checkout path used here.
User=YOUR_LINUX_USER
WorkingDirectory=/home/YOUR_LINUX_USER/solaire
Environment=HOME=/home/YOUR_LINUX_USER
ExecStart=/home/YOUR_LINUX_USER/solaire/.venv/bin/python /home/YOUR_LINUX_USER/solaire/boite_noire_hoymiles.py --web-only
# Une sortie inattendue, y compris propre, ne doit jamais laisser le tableau arrete.
Restart=always
RestartSec=15
TimeoutStartSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/YOUR_LINUX_USER/solaire /home/YOUR_LINUX_USER/AppData

[Install]
WantedBy=multi-user.target
